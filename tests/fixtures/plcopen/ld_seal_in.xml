<!--
  Start/stop seal-in, the "hello world" of ladder:

      Start          Stop      Motor
  |====| |====+====|/|=======( )====|
  |    Motor  |
  |====| |====+

  I/O is bound with address= (AT), and a configuration runs it every 20 ms.
-->
<project xmlns="http://www.plcopen.org/xml/tc6_0201">
  <fileHeader companyName="plcc" productName="plcc tests" productVersion="1" creationDateTime="2026-09-27T00:00:00"/>
  <contentHeader name="seal_in">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="SealIn" pouType="program">
        <interface>
          <localVars>
            <variable name="Start" address="%IX0.0"><type><BOOL/></type></variable>
            <variable name="Stop" address="%IX0.1"><type><BOOL/></type></variable>
            <variable name="Motor" address="%QX0.0"><type><BOOL/></type></variable>
          </localVars>
        </interface>
        <body>
          <LD>
            <comment localId="10" height="30" width="300">
              <position x="20" y="10"/>
              <content><xhtml:p xmlns:xhtml="http://www.w3.org/1999/xhtml">Seal-in: Motor runs from Start until Stop.</xhtml:p></content>
            </comment>
            <leftPowerRail localId="1" height="120" width="3">
              <position x="20" y="50"/>
              <connectionPointOut formalParameter=""><relPosition x="3" y="20"/></connectionPointOut>
              <connectionPointOut formalParameter=""><relPosition x="3" y="80"/></connectionPointOut>
            </leftPowerRail>
            <contact localId="2" negated="false" width="21" height="20">
              <position x="80" y="60"/>
              <connectionPointIn>
                <relPosition x="0" y="10"/>
                <connection refLocalId="1"><position x="80" y="70"/><position x="23" y="70"/></connection>
              </connectionPointIn>
              <connectionPointOut><relPosition x="21" y="10"/></connectionPointOut>
              <variable>Start</variable>
            </contact>
            <contact localId="3" negated="false" width="21" height="20">
              <position x="80" y="120"/>
              <connectionPointIn>
                <relPosition x="0" y="10"/>
                <connection refLocalId="1"><position x="80" y="130"/><position x="23" y="130"/></connection>
              </connectionPointIn>
              <connectionPointOut><relPosition x="21" y="10"/></connectionPointOut>
              <variable>Motor</variable>
            </contact>
            <contact localId="4" negated="true" width="21" height="20">
              <position x="160" y="60"/>
              <connectionPointIn>
                <relPosition x="0" y="10"/>
                <connection refLocalId="2"><position x="160" y="70"/><position x="101" y="70"/></connection>
                <connection refLocalId="3"><position x="160" y="70"/><position x="101" y="130"/></connection>
              </connectionPointIn>
              <connectionPointOut><relPosition x="21" y="10"/></connectionPointOut>
              <variable>Stop</variable>
            </contact>
            <coil localId="5" negated="false" storage="none" width="21" height="20">
              <position x="240" y="60"/>
              <connectionPointIn>
                <relPosition x="0" y="10"/>
                <connection refLocalId="4"><position x="240" y="70"/><position x="181" y="70"/></connection>
              </connectionPointIn>
              <connectionPointOut><relPosition x="21" y="10"/></connectionPointOut>
              <variable>Motor</variable>
            </coil>
            <rightPowerRail localId="6" height="40" width="3">
              <position x="320" y="50"/>
              <connectionPointIn>
                <relPosition x="0" y="20"/>
                <connection refLocalId="5"><position x="320" y="70"/><position x="261" y="70"/></connection>
              </connectionPointIn>
            </rightPowerRail>
          </LD>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations>
      <configuration name="Config0">
        <resource name="Res0">
          <task name="MainTask" interval="T#20ms" priority="0">
            <pouInstance name="seal" typeName="SealIn"/>
          </task>
        </resource>
      </configuration>
    </configurations>
  </instances>
</project>
