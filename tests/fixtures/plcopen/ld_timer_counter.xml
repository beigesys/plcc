<!--
  Standard function blocks in ladder rungs:

  rung 1: Enable ==| |== [TON T1  IN, PT := T#100ms] Q ==( Done )   ET => Elapsed
  rung 2: Enable ==| |== [TOF Toff IN, PT := T#50ms] Q ==( Lamp )   (Toff is not
          declared in the interface: plcc declares it)
  rung 3: CountEn ==| |== EN [CTU C1  CU <= Pulse, R <= Reset, PV := 3] ENO ==( Enabled )
                                          Q ==( Reached )   CV => Count
-->
<project xmlns="http://www.plcopen.org/xml/tc6_0201">
