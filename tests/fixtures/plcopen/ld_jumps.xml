<!--
  Jumps, labels and return.

  y=10   |==| Skip |==>>SKIP                 forward jump
  y=60   |== EN[ADD Count, 1] => Count       skipped while Skip
  y=110  SKIP:
  y=160  |==( Always )
  y=210  AGAIN:
  y=260  |== EN[ADD Loops, 1] => Loops
  y=310  [LT Loops, Limit] ==>>AGAIN         backward jump: loops until Loops >= Limit
  y=360  |==| Quit |==<RETURN>
  y=410  |==( AfterReturn )
-->
