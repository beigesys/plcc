<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Seal-in: Start latches the motor through its own contact, Stop breaks it.]]>
</Comment>
<Text>
<![CDATA[[XIC(Start) ,XIC(Motor) ]XIO(Stop)OTE(Motor);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Motor)OTE(RunLamp);]]>
</Text>
</Rung>
