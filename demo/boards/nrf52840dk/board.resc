:name: plcc-nrf52840dk
:description: nRF52840 DK — Cortex-M4F, BLE, GPIO

using sysbus

mach create "plc"
machine LoadPlatformDescription @platforms/cpus/nrf52840.repl
sysbus LoadELF @/board/firmware.elf

# Debug console — TCP:5021
emulation CreateServerSocketTerminal 5021 "debug_console" true
connector Connect uart0 debug_console

logLevel -1
start
