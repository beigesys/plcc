:name: plcc-stm32f4-discovery
:description: STM32F4 Discovery — Cortex-M4, UART, CAN, Modbus RTU

using sysbus

mach create "plc"
machine LoadPlatformDescription @platforms/boards/stm32f4_discovery.repl
sysbus LoadELF @/board/firmware.elf

# Debug console — TCP:5021
emulation CreateServerSocketTerminal 5021 "debug_console" false
connector Connect usart1 debug_console

# Modbus RTU — TCP:5020 (raw, no telnet negotiation)
emulation CreateServerSocketTerminal 5020 "modbus_rtu" false
connector Connect usart2 modbus_rtu

# Set CPU performance to maximum
cpu PerformanceInMips 1000
emulation SetAdvanceImmediately true

logLevel -1
start
