:name: plcc-stm32f4-discovery
:description: STM32F4 Discovery — Cortex-M4, UART, CAN, Modbus RTU

using sysbus

mach create "plc"
machine LoadPlatformDescription @platforms/boards/stm32f4_discovery.repl
sysbus LoadELF @/board/firmware.elf

# Debug console — TCP:5021, telnet localhost 5021 to watch
emulation CreateServerSocketTerminal 5021 "debug_console" true
connector Connect usart1 debug_console

# Modbus RTU — TCP:5020, FUXA connects here
emulation CreateServerSocketTerminal 5020 "modbus_rtu" true
connector Connect usart2 modbus_rtu

logLevel -1
start
