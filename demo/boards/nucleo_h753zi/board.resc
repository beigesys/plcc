:name: plcc-nucleo-h753zi
:description: Nucleo H753ZI — Cortex-M7, Ethernet, Modbus RTU

using sysbus

mach create "plc"
machine LoadPlatformDescription @platforms/boards/nucleo_h753zi.repl
sysbus LoadELF @/board/firmware.elf

# Debug console — TCP:5021
emulation CreateServerSocketTerminal 5021 "debug_console" true
connector Connect usart3 debug_console

# Modbus RTU — TCP:5020
emulation CreateServerSocketTerminal 5020 "modbus_rtu" true
connector Connect usart2 modbus_rtu

logLevel -1
start
