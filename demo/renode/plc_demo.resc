:name: plcc-plc-demo
:description: Water Treatment PLC on STM32F4 with Modbus RTU

using sysbus

mach create "plc"
machine LoadPlatformDescription @platforms/boards/stm32f4_discovery.repl
sysbus LoadELF @/demo/firmware.elf

showAnalyzer usart1

emulation CreateServerSocketTerminal 5020 "modbus_bridge" true
connector Connect usart2 modbus_bridge

logLevel -1
start
