# Build firmware from ST source using the plcc compiler image
FROM plcc AS compiler

# Copy ST source and platform firmware code
COPY tests/fixtures/programs/water_treatment.st /src/program.st
COPY tests/qemu/startup_modbus.c /src/
COPY tests/qemu/modbus_rtu.c /src/
COPY tests/qemu/modbus_rtu.h /src/
COPY tests/qemu/stm32f4.ld /src/

WORKDIR /src

# Compile ST → ARM object
RUN plcc compile program.st -o plc.o --target thumbv7em-unknown-none-eabihf

# Build firmware
RUN arm-none-eabi-gcc -mcpu=cortex-m4 -mthumb -mfloat-abi=hard -mfpu=fpv4-sp-d16 \
    -ffreestanding -nostdlib -I. -c startup_modbus.c -o startup.o \
    && arm-none-eabi-gcc -mcpu=cortex-m4 -mthumb -mfloat-abi=hard -mfpu=fpv4-sp-d16 \
    -ffreestanding -nostdlib -I. -c modbus_rtu.c -o modbus.o \
    && arm-none-eabi-gcc -mcpu=cortex-m4 -mthumb -mfloat-abi=hard -mfpu=fpv4-sp-d16 \
    -ffreestanding -nostdlib -T stm32f4.ld startup.o modbus.o plc.o -o firmware.elf -lgcc

FROM scratch
COPY --from=compiler /src/firmware.elf /firmware.elf
