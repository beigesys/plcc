# plcc PLC simulator with Modbus TCP for SCADA
#
# Compiles ST source and JIT-runs it with Modbus TCP on port 502.
# No Renode needed — runs at native speed.

# Step 1: Build plcc compiler
FROM rust:1.85-bookworm AS plcc
RUN apt-get update && apt-get install -y \
    wget lsb-release software-properties-common gnupg \
    && wget -q https://apt.llvm.org/llvm.sh && chmod +x llvm.sh && ./llvm.sh 21 \
    && apt-get install -y llvm-21-dev libpolly-21-dev && rm -rf /var/lib/apt/lists/*
ENV LLVM_SYS_211_PREFIX=/usr/lib/llvm-21
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
RUN cargo build --release -p plcc

# Step 2: Runtime image
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y libffi8 zlib1g libzstd1 && rm -rf /var/lib/apt/lists/*
COPY --from=plcc /build/target/release/plcc /usr/local/bin/plcc
COPY demo/st-programs/ /programs/

EXPOSE 502
CMD ["plcc", "sim", "/programs/water_treatment.st", "--scans", "0", "--interval-ms", "100", "--modbus", "502"]
