# Build stage: compile plcc
FROM rust:1.83-bookworm AS builder

# Install LLVM 21
RUN apt-get update && apt-get install -y \
    wget lsb-release software-properties-common gnupg \
    && wget https://apt.llvm.org/llvm.sh \
    && chmod +x llvm.sh \
    && ./llvm.sh 21 \
    && apt-get install -y llvm-21-dev \
    && rm -rf /var/lib/apt/lists/*

ENV LLVM_SYS_211_PREFIX=/usr/lib/llvm-21

WORKDIR /build
COPY . .
RUN cargo build --release -p plcc

# Runtime stage: just the binary + LLVM libs
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    wget lsb-release software-properties-common gnupg \
    && wget https://apt.llvm.org/llvm.sh \
    && chmod +x llvm.sh \
    && ./llvm.sh 21 \
    && apt-get install -y libllvm21 \
    && rm -rf /var/lib/apt/lists/* /llvm.sh

COPY --from=builder /build/target/release/plcc /app/plcc

EXPOSE 1502

ENTRYPOINT ["/app/plcc"]
CMD ["sim", "--help"]
