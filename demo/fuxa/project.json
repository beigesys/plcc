                            "address": "http://localhost:1881/_widgets/Tanks/squareTankLevel-v2.svg",
                            "type": "widget",
                            "svgGuid": "7ab11413ab_6aa11",
                            "svgContent": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"150\" height=\"150\" viewBox=\"0 0 150 150\" preserveAspectRatio=\"none\">\n  <!-- Livello acqua con path -->\n  <path id=\"waterShape_7ab11413ab_6aa11\" fill=\"#74b1e6ff\" d=\"M 9 101.4 Q 25.5 97.4, 42 101.4 Q 58.5 105.4, 75 101.4 Q 91.5 97.4, 108 101.4 Q 124.5 105.4, 141 101.4 V 141 H 9 Z\" stroke=\"#74b1e6ff\" stroke-linecap=\"round\" style=\"fill: rgb(116, 177, 230);\"></path>\n  <path id=\"waterShapeBorder_7ab11413ab_6aa11\" fill=\"none\" stroke=\"#3781d8ff\" stroke-width=\"4\" stroke-linecap=\"round\" d=\"M 9 101.4 Q 25.5 97.4, 42 101.4 Q 58.5 105.4, 75 101.4 Q 91.5 97.4, 108 101.4 Q 124.5 105.4, 141 101.4 V 141 H 9 Z\"></path>\n  <rect id=\"tankBorder_7ab11413ab_6aa11\" x=\"7\" y=\"7\" width=\"136\" height=\"136\" stroke=\"#888888\" stroke-width=\"4\" fill=\"none\" style=\"stroke: rgb(137, 137, 137);\"></rect>\n\n  <!-- Static preview (used in <img>) -->\n  <path id=\"previewWater_7ab11413ab_6aa11\" fill=\"#74b1e6\" d=\"M9 70 Q42 66, 75 70 Q108 74, 141 70 V141 H9 Z\" style=\"display: none;\"></path>\n\n  <text id=\"tankText_7ab11413ab_6aa11\" x=\"75\" y=\"85\" text-anchor=\"middle\" font-size=\"24\" fill=\"#000000\" font-family=\"Arial\" style=\"fill: rgb(0, 0, 0); font-size: 24px;\">30%</text>\n\n  \n</svg>",
                            "scriptContent": {
                                "moduleId": "wModule_7ab11413ab_6aa11",
                                "content": "var wModule_7ab11413ab_6aa11 = window.wModule_7ab11413ab_6aa11 || {};\n(function() {\n    \n    let initValue = 30;\n    //!export-start\n    let _pc_borderColor = \"#898989ff\";\n    let _pc_waterColor = \"#74b1e6ff\";\n    let _pc_waterBorderColor = \"#3781d8ff\";\n    let _pc_textColor = \"#000000ff\";\n    let _pn_textSize = 24;\n    let _pn_value = initValue;\n    let _pn_min = 0;\n    let _pn_max = 100;\n    \nwModule_7ab11413ab_6aa11._pc_borderColor = _pc_borderColor;\nwModule_7ab11413ab_6aa11._pc_waterColor = _pc_waterColor;\nwModule_7ab11413ab_6aa11._pc_waterBorderColor = _pc_waterBorderColor;\nwModule_7ab11413ab_6aa11._pc_textColor = _pc_textColor;\nwModule_7ab11413ab_6aa11._pn_textSize = _pn_textSize;\nwModule_7ab11413ab_6aa11._pn_value = _pn_value;\nwModule_7ab11413ab_6aa11._pn_min = _pn_min;\nwModule_7ab11413ab_6aa11._pn_max = _pn_max;//!export-end\n\n    function init() {\n      const pw = document.getElementById('previewWater_7ab11413ab_6aa11');\n      if (pw) pw.style.display = \"none\";\n\n      document.getElementById('tankBorder_7ab11413ab_6aa11').style.stroke = _pc_borderColor;\n      document.getElementById('waterShape_7ab11413ab_6aa11').style.fill = _pc_waterColor;\n      document.getElementById('tankText_7ab11413ab_6aa11').style.fill = _pc_textColor;\n      document.getElementById('tankText_7ab11413ab_6aa11').style.fontSize = _pn_textSize + 'px';\n      updateWaterLevel(_pn_value);\n    }\n\n    let animationFrame = null;\n\n    function updateWaterLevel(pct) {\n      const shape = document.getElementById('waterShape_7ab11413ab_6aa11');\n      const shapeBorder = document.getElementById('waterShapeBorder_7ab11413ab_6aa11');\n      pct = Math.max(_pn_min, Math.min(_pn_max, pct));\n      const relativePct = Math.round(((pct - _pn_min) / (_pn_max - _pn_min)) * 100);\n      const displayPct = Math.max(0, Math.min(100, relativePct));\n      document.getElementById('tankText_7ab11413ab_6aa11').textContent = displayPct + '%';\n\n      const x = 9;\n      const y = 9;\n      const width = 132;\n      const height = 132;\n      const fillHeight = height * (pct - _pn_min) / (_pn_max - _pn_min);\n      const topY = y + height - fillHeight;\n\n      const waveCount = 4;\n      const waveAmp = 4;\n      const waveWidth = width / waveCount;\n\n      let wavePath = `M ${x} ${topY}`;\n      for (let i = 0; i < waveCount; i++) {\n        const xStart = x + i * waveWidth;\n        const xMid = xStart + waveWidth / 2;\n        const xEnd = xStart + waveWidth;\n        const yCtrl = topY + (i % 2 === 0 ? -waveAmp : waveAmp);\n        wavePath += ` Q ${xMid} ${yCtrl}, ${xEnd} ${topY}`;\n      }\n      wavePath += ` V ${y + height} H ${x} Z`;\n\n      let waveBorderPath = `M ${x} ${topY}`;\n      for (let i = 0; i < waveCount; i++) {\n        const xStart = x + i * waveWidth;\n        const xMid = xStart + waveWidth / 2;\n        const xEnd = xStart + waveWidth;\n        const yCtrl = topY + (i % 2 === 0 ? -waveAmp : waveAmp);\n        waveBorderPath += ` Q ${xMid} ${yCtrl}, ${xEnd} ${topY}`;\n      }\n      waveBorderPath += ` V ${y + height} H ${x} Z`;\n\n      shape.setAttribute('d', wavePath);\n      shapeBorder.setAttribute('d', waveBorderPath);\n\n      shape.setAttribute('fill', _pc_waterColor);\n      shape.setAttribute('stroke', _pc_waterColor);\n      shape.setAttribute('stroke-width', '1');\n      shapeBorder.setAttribute('stroke', _pc_waterBorderColor);\n      shapeBorder.setAttribute('stroke-width', '4');\n      shape.setAttribute('stroke-linecap', 'round');\n      shapeBorder.setAttribute('stroke-linecap', 'round');\n    }\n\n    let animationTimer = null;\n\n    function putValue(id, value) {\n      switch(id) {\n        case '_pc_borderColor': _pc_borderColor = value; init(); break;\n        case '_pc_waterColor': _pc_waterColor = value; init(); break;\n        case '_pc_textColor': _pc_textColor = value; init(); break;\n        case '_pn_textSize': _pn_textSize = parseInt(value); init(); break;\n        case '_pn_value':\n          let newValue = parseFloat(value);\n          newValue = Math.max(_pn_min, Math.min(_pn_max, newValue));\n          const step = newValue > _pn_value ? 0.5 : -0.5;\n          const delay = 10;\n\n          const animateStep = () => {\n            if (_pn_value === newValue) {\n              animationTimer = null;\n              return;\n            }\n            _pn_value += step;\n            updateWaterLevel(_pn_value);\n            animationTimer = setTimeout(animateStep, delay);\n          };\n\n          if (animationTimer !== null) clearTimeout(animationTimer);\n          if (_pn_value !== newValue) animateStep();\n          break;\n      }\n    }\n\n    setTimeout(() => {\n      init();\n    }, 100);\n    \n  \nwModule_7ab11413ab_6aa11.init = init;\nwModule_7ab11413ab_6aa11.updateWaterLevel = updateWaterLevel;\nwModule_7ab11413ab_6aa11.putValue = putValue;\n})();\nwindow.wModule_7ab11413ab_6aa11=wModule_7ab11413ab_6aa11"
